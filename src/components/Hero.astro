---
import PokerChip from './PokerChip.astro';
import { site } from '../data/site';
import { toRoman } from '../lib/roman';

const year = toRoman(new Date().getFullYear());
const words = site.name.split(' ');
---

<section class="hero">
  <div class="hero__chip">
    <PokerChip />
  </div>

  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">
      <span class="cross" aria-hidden="true">✠</span>
      {site.role} · Portfolio {year}
    </p>
    <h1>
      {
        words.map((w, i) => (
          <span class="word" style={`--i:${i}`}>
            <span>{w}</span>
          </span>
        ))
      }
    </h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__cta">
      <a href="#works" class="text-link">View the works <span class="arrow" aria-hidden="true">↓</span></a>
      <a href="#contact" class="text-link muted">Get in touch</a>
    </div>
  </div>

  <a href="#works" class="hero__scroll" aria-label="Scroll to works">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 7rem 5rem;
  }

  .hero__chip {
    position: absolute;
    top: 50%;
    /* Bleeds off the edge a little, but keeps the monogram in view. */
    right: max(-7vw, -110px);
    width: min(74vmin, 780px);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: rise 1.2s var(--ease) 0.2s forwards;
  }
  .cross {
    color: var(--gold);
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(4rem, 12vw, 10.5rem);
    line-height: 0.88;
    letter-spacing: -0.025em;
    max-width: 9ch;
  }
  .word {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .word > span {
    display: inline-block;
    transform: translateY(105%);
    animation: word 1.4s var(--ease) forwards;
    animation-delay: calc(0.35s + var(--i) * 0.12s);
  }
  .hero__tagline {
    margin-top: 2.25rem;
    max-width: 30rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--muted);
    opacity: 0;
    animation: rise 1.2s var(--ease) 0.9s forwards;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    margin-top: 2.75rem;
    font-size: 0.95rem;
    opacity: 0;
    animation: rise 1.2s var(--ease) 1.1s forwards;
  }
  .muted {
    color: var(--muted);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    width: 1px;
    height: 64px;
    background: rgba(243, 237, 226, 0.12);
    overflow: hidden;
  }
  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, var(--gold));
    animation: drip 2.6s var(--ease-soft) infinite;
  }

  @keyframes word {
    to {
      transform: none;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes drip {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (max-width: 860px) {
    .hero {
      align-items: flex-end;
    }
    .hero__eyebrow {
      letter-spacing: 0.18em;
      font-size: 0.68rem;
    }
    .hero__chip {
      top: 4rem;
      right: -32vw;
      width: 100vw;
      transform: none;
      opacity: 0.55;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>
