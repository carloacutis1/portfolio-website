---
import { site } from '../data/site';
---

<section id="about" class="section">
  <div class="container about">
    <header class="section-head" data-reveal>
      <span class="numeral">II.</span>
      <h2>About</h2>
    </header>

    <div class="about__body">
      <div class="about__text">
        {
          site.about.map((para, i) => (
            <p class:list={{ lead: i === 0 }} data-reveal style={`--i:${i}`}>
              {para}
            </p>
          ))
        }
      </div>

      <aside class="about__skills" data-reveal style="--i:2">
        {
          site.skills.map((g) => (
            <div class="skill-group">
              <h3 class="eyebrow">{g.group}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </aside>
    </div>
  </div>
</section>

<style>
  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  .about__text {
    display: grid;
    gap: 1.5rem;
    color: var(--muted);
    max-width: 40rem;
  }
  .lead {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.3;
    color: var(--candle);
  }
  /* A whisper of the illuminated initial. */
  .lead::first-letter {
    float: left;
    font-size: 3.4em;
    line-height: 0.82;
    padding: 0.06em 0.12em 0 0;
    color: var(--gold);
    font-style: italic;
  }

  .about__skills {
    display: grid;
    gap: 2.25rem;
    padding-top: 0.5rem;
  }
  .about__skills h3 {
    font-family: var(--sans);
    margin-bottom: 1rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    border: 1px solid rgba(243, 237, 226, 0.1);
    border-radius: 999px 999px 999px 999px;
    background: linear-gradient(180deg, rgba(243, 237, 226, 0.04), rgba(243, 237, 226, 0.01));
    transition:
      border-color 0.5s var(--ease),
      color 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  li:nth-child(5n + 1):hover { --c: var(--ruby); }
  li:nth-child(5n + 2):hover { --c: var(--sapphire); }
  li:nth-child(5n + 3):hover { --c: var(--emerald); }
  li:nth-child(5n + 4):hover { --c: var(--amber); }
  li:nth-child(5n + 5):hover { --c: var(--amethyst); }
  li:hover {
    border-color: var(--c);
    box-shadow:
      0 0 24px -6px var(--c),
      inset 0 0 12px -4px var(--c);
  }

  @media (max-width: 860px) {
    .about__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
