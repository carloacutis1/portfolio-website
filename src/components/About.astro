---
import { site } from '../data/site';
---

<section id="about" class="section">
  <div class="container about">
    <header class="section-head" data-reveal>
      <span class="numeral">II.</span>
      <h2>About</h2>
    </header>

    <div class="about__body">
      <div class="about__text">
        {
          site.about.map((para, i) => (
            <p class:list={{ lead: i === 0 }} data-reveal style={`--i:${i}`}>
              {para}
            </p>
          ))
        }
      </div>

      <aside class="about__skills" data-reveal style="--i:2" aria-label="Skills">
        <dl>
          {
            site.skills.map((g) => (
              <div class="skill-group">
                <dt class="eyebrow">{g.group}</dt>
                <dd>
                  <ul>
                    {g.items.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .about__body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  .about__text {
    display: grid;
    gap: 1.5rem;
    color: var(--muted);
    max-width: 40rem;
  }
  .lead {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.3;
    color: var(--candle);
  }

  /* Skills: a quiet typeset list, one group per row between hairline rules. */
  .about__skills dl {
    margin: 0;
    border-top: 1px solid rgba(243, 237, 226, 0.08);
  }
  .skill-group {
    padding-block: 1.25rem;
    border-bottom: 1px solid rgba(243, 237, 226, 0.08);
  }
  .skill-group dt {
    margin-bottom: 0.6rem;
    color: var(--gold);
    font-size: 0.68rem;
  }
  /* Separators sit before each item; the ones that wrap to the start of a line are
     pushed into the clipped margin, so no line ever begins or ends with a dot. */
  dd {
    margin: 0;
    overflow: hidden;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-left: -1.4em;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--candle);
  }
  li::before {
    content: '·';
    display: inline-block;
    width: 1.4em;
    text-align: center;
    color: var(--faint);
  }

  @media (max-width: 860px) {
    .about__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
