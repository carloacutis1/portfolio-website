---
import ProjectPane from './ProjectPane.astro';
import { projects } from '../data/projects';

// Everything that isn't a flagship. Keep each project's position in the full list
// so its numeral matches its detail page.
const others = projects.map((project, index) => ({ project, index })).filter(({ project }) => !project.flagship);
---

<section id="more-work" class="section more">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2>More Work</h2>
      <p>Team projects, coursework, and things I’ve built on my own. Hover a window to let the light through.</p>
    </header>

    <div class="grid">
      {others.map(({ project, index }) => <ProjectPane project={project} index={index} />)}
    </div>
  </div>
</section>

<style>
  .more {
    padding-top: clamp(4rem, 9vw, 7rem);
  }
  .more .section-head h2 {
    font-size: clamp(2.4rem, 5vw, 4rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(4rem, 7vw, 6.5rem) clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  /* The middle column sits lower: the eye flows in a gentle wave. */
  .grid > :global(:nth-child(3n + 2)) {
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  .grid > :global(:nth-child(3n + 3)) {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid > :global(:nth-child(n)) {
      margin-top: 0;
    }
    .grid > :global(:nth-child(even)) {
      margin-top: clamp(3rem, 10vw, 6rem);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 26rem;
      margin-inline: auto;
    }
    .grid > :global(:nth-child(n)) {
      margin-top: 0;
    }
  }
</style>
